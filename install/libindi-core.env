# Pins the prebuilt INDI core (headers + client lib) tarball install.sh
# fetches into /usr/local for pyindi-client — see
# .github/workflows/build-libindi-armhf.yml and docs/TROUBLESHOOTING.md.
# Regenerate LIBINDI_CORE_SHA256 with: sha256sum <asset>
LIBINDI_CORE_TAG=libindi-armhf-vPENDING
LIBINDI_CORE_ASSET=libindi-core-armhf-bullseye-vPENDING.tar.gz
LIBINDI_CORE_SHA256=PENDING
